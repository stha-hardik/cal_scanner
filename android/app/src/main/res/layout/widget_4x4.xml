<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/tv_title"
            android:text="Cal AI"
            android:textColor="@color/w_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/w_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="bottom"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_calories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/w_text_primary"
            android:textSize="44sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="8dp"
            android:text="/ 2000 kcal"
            android:textColor="@color/w_text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_calories"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="2dp"
        android:max="100"
        android:progressDrawable="@drawable/bar_calories" />

    <TextView
        android:id="@+id/tv_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/w_text_body"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:id="@+id/lbl_protein"
                android:text="Protein"
                android:textColor="@color/w_text_body"
                android:textSize="13sp" />
            <ProgressBar
                android:id="@+id/pb_protein"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/bar_protein" />
            <TextView
                android:id="@+id/tv_protein"
                android:layout_width="78dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0/0g"
                android:textColor="@color/w_text_body"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:id="@+id/lbl_carbs"
                android:text="Carbs"
                android:textColor="@color/w_text_body"
                android:textSize="13sp" />
            <ProgressBar
                android:id="@+id/pb_carbs"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/bar_carbs" />
            <TextView
                android:id="@+id/tv_carbs"
                android:layout_width="78dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0/0g"
                android:textColor="@color/w_text_body"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:id="@+id/lbl_fat"
                android:text="Fat"
                android:textColor="@color/w_text_body"
                android:textSize="13sp" />
            <ProgressBar
                android:id="@+id/pb_fat"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/bar_fat" />
            <TextView
                android:id="@+id/tv_fat"
                android:layout_width="78dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0/0g"
                android:textColor="@color/w_text_body"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:id="@+id/btn_scan"
        android:background="@drawable/widget_button_bg"
        android:gravity="center"
        android:text="📷  Scan a meal"
        android:textColor="@color/w_btn_text"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
